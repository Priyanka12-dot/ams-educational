{
  "name": "@ams/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src tests",
    "typecheck": "pnpm --filter @ams/shared build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @ams/shared build && vitest run",
    "test:unit": "pnpm --filter @ams/shared build && vitest run tests/unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/persistence/migrate.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@ams/shared": "workspace:*",
    "@fastify/cookie": "10.0.1",
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "10.2.1",
    "argon2": "0.41.1",
    "drizzle-orm": "0.38.3",
    "fastify": "5.2.0",
    "jose": "5.9.6",
    "pg": "8.23.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.30.1",
    "typescript": "5.7.2",
    "tsx": "4.19.2",
    "vitest": "2.1.8"
  }
}
