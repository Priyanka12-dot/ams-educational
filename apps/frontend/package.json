    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "tailwindcss": "3.4.16",
    "postcss": "8.4.49",
    "autoprefixer": "10.4.20"
