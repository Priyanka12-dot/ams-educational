{
  "name": "ams-educational",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "pnpm --filter @ams/backend test:unit",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @ams/backend db:generate",
    "db:migrate": "pnpm --filter @ams/backend db:migrate",
    "db:seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "turbo": "2.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "eslint": "9.17.0",
    "typescript-eslint": "8.72.0"
  }
}
